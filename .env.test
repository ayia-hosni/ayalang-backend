NODE_ENV=test

# Postgres (a real, disposable database used only for e2e tests)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=aya_interviewer_test
DB_SSL=false

# Auth
JWT_SECRET=test-secret

# AWS / S3 (unused in tests — S3Service is mocked, kept for config completeness)
AWS_REGION=us-east-1
S3_AUDIO_BUCKET=aya-interviewer-audio-test

CORS_ORIGIN=http://localhost:4200
