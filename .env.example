PORT=3333
NODE_ENV=development

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=aya_interviewer
DB_SSL=false

# Auth
JWT_SECRET=dev-secret-change-me

# AWS / S3
AWS_REGION=us-east-1
S3_AUDIO_BUCKET=aya-interviewer-audio-dev

# CORS: comma-separated list of allowed origins (leave unset to allow all in dev)
CORS_ORIGIN=http://localhost:4200
